# Leave both unset for local dev - Vite's dev server proxy (vite.config.js)
# already forwards /api requests to your local backend on :5001.

# Only needed for a deployed build (e.g. on Vercel): your deployed
# backend's URL, no trailing slash.
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Only needed if the deployed backend has API_SECRET set - must match it
# exactly. Note this is NOT truly secret once built into the frontend (see
# the comment in App.jsx) - it just keeps the API from being crawled.
# VITE_API_SECRET=
